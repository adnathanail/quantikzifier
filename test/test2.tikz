\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=none] (0) at (-0.75, 0.5) {};
		\node [style=none] (1) at (-0.75, -0.5) {};
		\node [style=X phase dot] (2) at (0, 0) {$\alpha$};
		\node [style=Z dot] (3) at (1, 0) {};
		\node [style=none] (4) at (1.75, 0.5) {};
		\node [style=none] (5) at (1.75, -0.5) {};
		\node [style=none] (6) at (2.5, 0) {$\propto$};
		\node [style=none] (7) at (3.25, 0.5) {};
		\node [style=none] (8) at (3.25, -0.5) {};
		\node [style=Z dot] (9) at (4, 0.5) {};
		\node [style=Z dot] (10) at (4, -0.5) {};
		\node [style=X dot] (11) at (5, 0.5) {};
		\node [style=X dot] (12) at (5, -0.5) {};
		\node [style=none] (13) at (5.75, 0.5) {};
		\node [style=none] (14) at (5.75, -0.5) {};
		\node [style=Z dot] (15) at (5, 0) {};
		\node [style=X phase dot] (16) at (5.5, 0) {$\alpha$};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw [looseness=1.25, bend left] (0.center) to (2);
		\draw [looseness=1.25, bend left] (2) to (1.center);
		\draw (2) to (3);
		\draw [looseness=1.25, bend right] (3) to (5.center);
		\draw [looseness=1.25, bend left] (3) to (4.center);
		\draw (7.center) to (9);
		\draw (9) to (11);
		\draw (11) to (13.center);
		\draw (8.center) to (10);
		\draw (10) to (12);
		\draw (12) to (14.center);
		\draw (10) to (11);
		\draw (9) to (12);
		\draw (11) to (15);
		\draw (15) to (12);
		\draw (15) to (16);
	\end{pgfonlayer}
\end{tikzpicture}
